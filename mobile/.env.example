# URL do backend que o APARELHO vai alcançar.
# Dev (celular na mesma Wi-Fi do PC): use o IP do PC — o compose expõe :8000. NÃO use localhost
# (no celular, localhost é o próprio aparelho). Descubra o IP com `ipconfig` (Windows).
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
# Produção: o domínio HTTPS do nginx.
#   EXPO_PUBLIC_API_URL=https://seu-dominio.com
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
