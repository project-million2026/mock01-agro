# .gitignore generated by Antigravity

# Secret environment file – never version
acesso.env

# Documentation folder
/docs/

# Node.js artifacts
node_modules/
yarn.lock
dist/
.next/
coverage/
# O app mobile é um projeto próprio dentro do repo (monorepo sem workspaces): o SEU yarn.lock
# PRECISA ser versionado (o CI mobile roda --frozen-lockfile). A regra `yarn.lock` acima é global,
# então negamos aqui. Mesma ideia que já usamos para arquivos de teste no filtro do CI.
!mobile/yarn.lock

# Mobile (Expo) — artefatos de build/dev
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
*.egg-info/
*.egg
*.manifest
*.spec
build/
venv/
.venv/
.ruff_cache/
.pytest_cache/
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS artefacts
.DS_Store
Thumbs.db

# Local dev / scratch (nunca versionar)
# tests/local-layer/ = cópia-scratch do projeto (dev local); .python-version = pin pyenv local
# (Docker/CI já fixam Python 3.11). Comentários de .gitignore só valem no início da linha.
tests/local-layer/
.python-version
# Override de compose só para dev local (portas alternativas p/ rodar DB de teste).
docker-compose.local-test.yml

# Certificados TLS (nunca versionar)
certs/*.pem
certs/*.key

# Anexos de O.S. (PDF) — storage local em dev/prod (volume no VPS); nunca versionar
python-backend/data/

# Playwright (E2E)
/test-results/
/playwright-report/
/blob-report/
/.playwright/
