# .env.example — copie para .env e preencha. NUNCA commite o .env real.
# Ver .agents/standards/SECURITY_GUIDE.md (segredos fora do código).

# --- Banco (TimescaleDB + PostGIS) ---
# POSTGRES_USER é o DONO do schema (superuser do container) — usado só pelas MIGRAÇÕES e pelo
# prod_bootstrap (criar papéis/policies). A aplicação NÃO conecta com ele.
POSTGRES_DB=agro_telemetry
POSTGRES_USER=agro_admin
POSTGRES_PASSWORD=troque_esta_senha_forte

# --- RLS (F2.2b): papéis de conexão em runtime (NÃO-superuser) ---
# O compose monta as URLs de runtime a partir destas senhas. O prod_bootstrap (roda como DONO no
# start da API) define LOGIN+senha destes papéis a partir daqui. agro_app = API (RLS aplicado);
# agro_worker = ingestão/worker (BYPASSRLS). Use senhas fortes e distintas.
AGRO_APP_PASSWORD=troque_senha_forte_do_app
AGRO_WORKER_PASSWORD=troque_senha_forte_do_worker
# Painel admin do sistema (F3): papel privilegiado agro_sysadmin (BYPASSRLS) + segredo JWT SEPARADO.
AGRO_SYSADMIN_PASSWORD=troque_senha_forte_do_sysadmin
SYSADMIN_JWT_SECRET=gere_um_segredo_aleatorio_longo_do_painel

# O compose define DATABASE_URL (API=agro_app / worker=agro_worker) e ALEMBIC_DATABASE_URL (dono)
# automaticamente a partir das variáveis acima — não precisa setá-las aqui para o Docker. Para rodar
# o Alembic/manutenção FORA do Docker, exporte ALEMBIC_DATABASE_URL apontando para o DONO:
# ALEMBIC_DATABASE_URL=postgresql+psycopg://agro_admin:troque_esta_senha_forte@localhost:5432/agro_telemetry

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Segurança (OBRIGATÓRIO trocar; boot falha se ficar em 'change_me') ---
JWT_SECRET=gere_um_segredo_aleatorio_longo
HMAC_SECRET=gere_outro_segredo_aleatorio_longo

# --- Ambiente / CORS ---
# 'production' faz o boot exigir segredos não-default. Homologação pode usar 'staging'.
ENVIRONMENT=production
# Origens permitidas do dashboard (o back valida). Em prod, o domínio público (https).
CORS_ORIGINS=https://seu-dominio.com
# Subdomínio por org (F2.2b): domínio-base para a trava de subdomínio (ex.: agrotelemetry.com).
# VAZIO = middleware desligado (use só se tiver wildcard DNS *.dominio + certificado wildcard TLS).
BASE_DOMAIN=
# Concorrência do worker (paralelismo por dispositivo). Default 8; ajuste conforme os núcleos.
# WORKER_CONCURRENCY=8

# --- Plano / Feature flags (definido por quem provisiona a instância; o cliente NÃO altera) ---
# standard | pro | enterprise. Decide os módulos (ex.: 'pro' tem Estoque; KML só no 'enterprise').
PLAN=enterprise
# Overrides por instância (features exclusivas), separados por vírgula. Ex.: FEATURES_EXTRA=stock
# FEATURES_EXTRA=
# FEATURES_DISABLED=

# --- Clima (Open-Meteo) ---
# FREE (dev/homologação, uso NÃO-comercial): deixe como está — sem key. Em produção COMERCIAL, o
# tier free não é permitido: assine o plano ($29/mês) e troque a base + key abaixo (código não muda):
#   OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
#   OPEN_METEO_API_KEY=sua_key
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=
# WEATHER_CACHE_TTL=3600      # TTL do cache Redis (s). 1h mantém consumo <10% do rate limit free.
# WEATHER_TIMEZONE=auto

# --- Mapa de clima (add-on VISUAL opcional, feature 'weather_map') ---
# Camada de tiles (OpenWeatherMap Weather Maps 1.0, incluída no FREE). A key fica SÓ no backend
# (proxy /api/weather/tiles) — nunca vai ao browser. Sem key, a aba Mapa avisa que falta configurar.
# Cadastro grátis: home.openweathermap.org/api_keys. Habilite o add-on por cliente com
# FEATURES_EXTRA=weather_map (ou plano enterprise, que já inclui).
# OPENWEATHER_API_KEY=
# WEATHER_TILE_CACHE_TTL=900   # TTL do cache de tiles (s). Tiles são globais → cache compartilhado.

# --- Flespi ---
# ATENÇÃO: rotacione o token no painel do Flespi (o anterior foi exposto no repositório).
FLESPI_TOKEN=FlespiToken COLE_UM_TOKEN_NOVO_AQUI
FLESPI_DEVICE_IDS=8539920
FLESPI_MQTT_HOST=mqtt.flespi.io
FLESPI_MQTT_PORT=8883
